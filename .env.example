# ---------------------------------------------------------------------------
# Sahajta Odoo MCP server: configuration. Copy to .env and fill in.
# Every safety switch defaults to the safest value; change only what you need.
# ---------------------------------------------------------------------------

# --- Odoo -----------------------------------------------------------------------
ODOO_URL=https://sahajta.odoo.com
# Database name (on odoo.com this is usually the sub-domain). Optional for JSON-2, required for legacy JSON-RPC.
ODOO_DB=sahajta
# auto = use Odoo 19+ JSON-2 API, fall back to legacy JSON-RPC on older Odoo.
ODOO_PROTOCOL=auto
# Odoo Online asks for throttled, non-parallel API calls. Keep 1 unless you host Odoo yourself / on Odoo.sh.
ODOO_MAX_PARALLEL_REQUESTS=1

# --- Local (stdio) mode only: one person, their own key -------------------------------
# In company (http) mode leave these empty: each person signs in with their own key.
ODOO_LOGIN=
ODOO_API_KEY=



# --- What the AI may do ---------------------------------------------------------------
# read_only (default): search, read, count, reports. No change tools are even shown to Claude.
# read_write: also create / update / press workflow buttons / log notes, always with preview + approval.
MCP_ACCESS_MODE=read_only
# Every change must be previewed and confirmed with a signed token. Keep this true.
MCP_REQUIRE_PREVIEW=true
# Archiving hides records (reversible in Odoo). Off by default.
MCP_ALLOW_ARCHIVE=false
# Cancel / reset-to-draft / mark-lost type buttons. Off by default.
MCP_ALLOW_CANCEL_ACTIONS=false
# Anything that e-mails/SMSes/messages people (send quotation, chatter messages to followers). Off by default.
MCP_ALLOW_OUTBOUND_MESSAGES=false

# Time zone used when the Odoo user's profile has none (e.g. Asia/Kolkata). Default: UTC.
# MCP_DEFAULT_TIMEZONE=Asia/Kolkata

# Who people should ask to switch something on for Claude (named in refusals). Default: your administrator.
# MCP_ADMIN_CONTACT=Pranamya

# Limits
MCP_DEFAULT_READ_LIMIT=50
MCP_MAX_READ_RECORDS=200
MCP_MAX_WRITE_RECORDS=20
MCP_READS_PER_MINUTE=120
MCP_WRITES_PER_MINUTE=30

# Optional extra restrictions (comma-separated, globs allowed, e.g. hr.*)
# MCP_BLOCKED_MODELS=hr.payslip,hr.employee
# MCP_READONLY_MODELS=account.*
# If set, ONLY these models can be changed:
# MCP_WRITABLE_MODELS=crm.lead,res.partner,project.task,sale.order,sale.order.line,mail.activity
# MCP_BLOCKED_METHODS=action_confirm
# Methods callable even though they are not a button in Odoo's screens ("model:method"):
# MCP_EXTRA_ALLOWED_METHODS=

# Append-only audit log file (JSON lines; field names and ids only, never values or keys)
# MCP_AUDIT_LOG_FILE=/data/audit.log

# --- Company connector (http) mode -------------------------------------------------------
# The public https address of THIS server (what you paste into Claude, minus /mcp).
MCP_PUBLIC_URL=https://odoo-mcp.sahajta.ai
# 32+ random characters. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Encrypts stored Odoo keys and signs tokens. Keep it secret; changing it signs everybody out.
MCP_SECRET=
MCP_DATA_DIR=/data
# Only these exact Odoo logins may connect (recommended):
# MCP_ALLOWED_LOGINS=person@example.com
# ...or only logins on your company e-mail domain:
# MCP_ALLOWED_LOGIN_DOMAINS=sahajta.ai
# Set true only when running behind a reverse proxy that sets X-Forwarded-For (Caddy, nginx, Cloud Run...)
MCP_TRUST_PROXY_HEADERS=true

# Usage report (GET /admin/usage, `sahajta-odoo-mcp usage`): any long random value; unset = report disabled.
# Needs Redis (the report reads the 30-day usage history stored there).
MCP_ADMIN_TOKEN=
